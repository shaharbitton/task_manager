@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun ChoresScreen(viewModel: TaskViewModel, onNavigateToStore: () -> Unit) {
    val chores by viewModel.allChores.collectAsStateWithLifecycle()
    val users by viewModel.allUsers.collectAsStateWithLifecycle()
    val currentUser by viewModel.currentUser.collectAsStateWithLifecycle()
    val currentUserRole by viewModel.currentUserRole.collectAsStateWithLifecycle()
    val currentLang by viewModel.language.collectAsStateWithLifecycle()
    var showAddChoreDialog by remember { mutableStateOf(false) }

    val kidsList = remember(users) {
        users.filter { it.role == UserRole.CHILD }
    }

    Scaffold(
        topBar = {
            TopAppBar(
                title = { Text(Localization.get("menu_chores", currentLang), fontWeight = FontWeight.Bold) },
                actions = {
                    LanguageSelector(viewModel)
                }
            )
        },
        floatingActionButton = {
            val isAdultOrManager = currentUserRole?.isManager == true || currentUser?.role == UserRole.ADULT
            if (isAdultOrManager) {
                FloatingActionButton(onClick = { showAddChoreDialog = true }, containerColor = MaterialTheme.colorScheme.primary) {
                    Icon(Icons.Default.Add, contentDescription = Localization.get("new_family_chore", currentLang))
                }
            }
        }
    ) { padding ->
        val activeUserId = currentUser?.id
        val filteredChores = remember(chores, currentUser, currentUserRole) {
            val role = currentUserRole
            if (currentUser?.role == UserRole.CHILD && role?.allowSeeOtherTasks != true) {
                chores.filter { it.assignedToUserId == activeUserId }
            } else {
                chores
            }
        }

        if (filteredChores.isEmpty()) {
            Box(Modifier.fillMaxSize().padding(padding), contentAlignment = Alignment.Center) {
                Column(horizontalAlignment = Alignment.CenterHorizontally) {
                    Icon(Icons.Default.Face, contentDescription = null, Modifier.size(64.dp), tint = Color.Gray)
                    val isAdultOrManager = currentUserRole?.isManager == true || currentUser?.role == UserRole.ADULT
                    val noChoresText = if (isAdultOrManager) {
                        if (currentLang == "HE") "אין מטלות יומיות עדיין. לחץ/י על + כדי להגדיר משימה לילדים." else "No daily chores yet. Tap + to assign a chore to kids."
                    } else {
                        if (currentLang == "HE") "מצוין! אין לך מטלות יומיות שממתינות לביצוע." else "Awesome! You have no pending daily chores."
                    }
                    Text(noChoresText, color = Color.Gray)
                }
            }
        } else {
            LazyColumn(
                modifier = Modifier.fillMaxSize().padding(padding),
                contentPadding = PaddingValues(16.dp),
                verticalArrangement = Arrangement.spacedBy(12.dp)
            ) {
                items(filteredChores) { chore ->
                    val assigneeName = users.find { it.id == chore.assignedToUserId }?.name ?: "Everyone"
                    val isChoreOwner = chore.assignedToUserId == activeUserId
                    val isAdult = currentUser?.role == UserRole.ADULT

                    Card(
                        modifier = Modifier.fillMaxWidth().testTag("chore_card_${chore.id}"),
                        border = if (chore.status == TaskStatus.PENDING_APPROVAL) BorderStroke(2.dp, MaterialTheme.colorScheme.primary) else null
                    ) {
                        Column(Modifier.padding(16.dp)) {
                            Row(verticalAlignment = Alignment.CenterVertically) {
                                Box(
                                    modifier = Modifier
                                        .size(36.dp)
                                        .background(getAssigneeColor(chore.assignedToUserId), CircleShape),
                                    contentAlignment = Alignment.Center
                                ) {
                                    Text(assigneeName.take(1).uppercase(), color = Color.White, fontWeight = FontWeight.Bold)
                                }
                                Spacer(Modifier.width(12.dp))
                                Column(Modifier.weight(1f)) {
                                    Text(
                                        text = chore.title,
                                        style = MaterialTheme.typography.titleMedium,
                                        fontWeight = FontWeight.Bold,
                                        textDecoration = if (chore.status == TaskStatus.DONE) androidx.compose.ui.text.style.TextDecoration.LineThrough else null,
                                        color = if (chore.status == TaskStatus.DONE) Color.Gray else Color.Unspecified
                                    )
                                    val assignedToLabel = if (currentLang == "HE") "באחריות" else "Assigned to"
                                    val pointsLabel = if (currentLang == "HE") "נקודות" else "points"
                                    Text(
                                        text = "$assignedToLabel: $assigneeName • ${chore.rewardPoints} $pointsLabel",
                                        style = MaterialTheme.typography.bodySmall,
                                        color = Color.Gray
                                    )
                                }
                                
                                // Manage button (Delete)
                                val canDelete = currentUserRole?.allowDeleteTasks == true || currentUserRole?.isManager == true
                                if (canDelete) {
                                    IconButton(onClick = { viewModel.deleteTask(chore) }) {
                                        Icon(Icons.Default.Delete, contentDescription = "Delete Chore", tint = MaterialTheme.colorScheme.error)
                                    }
                                }
                            }
                            
                            Spacer(Modifier.height(12.dp))
                            
                            // Status specific operational layouts
                            when (chore.status) {
                                TaskStatus.TODO -> {
                                    Button(
                                        onClick = { viewModel.completeTask(chore) },
                                        enabled = isChoreOwner || isAdult,
                                        modifier = Modifier.fillMaxWidth().testTag("complete_chore_${chore.id}"),
                                        shape = RoundedCornerShape(12.dp)
                                    ) {
                                        Text(if (currentLang == "HE") "סימנתי כבוצע! (שלח לאישור הורה)" else "Done! (Send for approval)")
                                    }
                                }
                                TaskStatus.PENDING_APPROVAL -> {
                                    if (isAdult) {
                                        Row(
                                            modifier = Modifier.fillMaxWidth(),
                                            horizontalArrangement = Arrangement.spacedBy(8.dp)
                                        ) {
                                            Button(
                                                onClick = { viewModel.approveChore(chore, true) },
                                                colors = ButtonDefaults.buttonColors(containerColor = MaterialTheme.colorScheme.primary),
                                                modifier = Modifier.weight(1f).testTag("approve_chore_${chore.id}"),
                                                shape = RoundedCornerShape(12.dp)
                                            ) {
                                                Icon(Icons.Default.Check, contentDescription = null)
                                                Spacer(Modifier.width(4.dp))
                                                Text(if (currentLang == "HE") "אשר וסמן כהושלם" else "Approve & Reward")
                                            }
                                            OutlinedButton(
                                                onClick = { viewModel.approveChore(chore, false) },
                                                colors = ButtonDefaults.outlinedButtonColors(contentColor = MaterialTheme.colorScheme.error),
                                                border = BorderStroke(1.dp, MaterialTheme.colorScheme.error),
                                                modifier = Modifier.weight(1f).testTag("reject_chore_${chore.id}"),
                                                shape = RoundedCornerShape(12.dp)
                                            ) {
                                                Icon(Icons.Default.Close, contentDescription = null)
                                                Spacer(Modifier.width(4.dp))
                                                Text(if (currentLang == "HE") "דחה / בטל" else "Reject")
                                            }
                                        }
                                    } else {
                                        Surface(
                                            color = MaterialTheme.colorScheme.secondaryContainer,
                                            shape = RoundedCornerShape(8.dp),
                                            modifier = Modifier.fillMaxWidth()
                                        ) {
                                            Text(
                                                text = if (currentLang == "HE") "ממתין לאישור הורה לקבלת הנקודות..." else "Pending parental approval to receive points...",
                                                style = MaterialTheme.typography.bodyMedium,
                                                color = MaterialTheme.colorScheme.onSecondaryContainer,
                                                modifier = Modifier.padding(12.dp),
                                                textAlign = TextAlign.Center
                                            )
                                        }
                                    }
                                }
                                TaskStatus.DONE -> {
                                    OutlinedButton(
                                        onClick = { viewModel.unapproveChore(chore) },
                                        enabled = isAdult,
                                        modifier = Modifier.fillMaxWidth().testTag("reset_chore_${chore.id}"),
                                        shape = RoundedCornerShape(12.dp)
                                    ) {
                                        Text(if (currentLang == "HE") "מטלה הושלמה (החזר למצב פעיל)" else "Chore Completed (Re-open)")
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if (showAddChoreDialog) {
        AddChoreDialog(
            languageCode = currentLang, 
            familyMembers = kidsList, 
            onDismiss = { showAddChoreDialog = false }, 
            onAdd = { title, points, kidId ->
                viewModel.addTask(title = title, isChore = true, assignedToUserId = kidId, rewardPoints = points)
                showAddChoreDialog = false
            }
        )
    }
}

